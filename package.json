{
  "name": "apartments-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Apartments CRUD API with WebP image uploads to S3",
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc",
    "start": "node --use-system-ca dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --use-system-ca --import tsx --test tests/schemas.test.ts tests/db.test.ts tests/api.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
